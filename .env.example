# Copiá este archivo como ".env" y completá los valores.
# El archivo .env NO se sube al repositorio.

# Modo desarrollo
DEBUG=True

# Clave de Django (en local podés dejarla vacía y se usa la de desarrollo)
SECRET_KEY=

# Hosts permitidos
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos:
# - Vacío  -> usa SQLite (db.sqlite3), no hace falta instalar nada
# - Con Postgres local -> postgres://postgres:TU_CLAVE@localhost:5432/velaris
DATABASE_URL=